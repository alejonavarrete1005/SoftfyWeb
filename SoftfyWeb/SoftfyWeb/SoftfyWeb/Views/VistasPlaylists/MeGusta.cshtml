@model SoftfyWeb.Modelos.Dtos.MeGustaRespuestaDto
@{
    ViewData["Title"] = "Mis canciones Me Gusta";
}

<h2 class="text-center">Mis canciones Me Gusta</h2>

@if (ViewBag.Message != null)
{
    <div class="alert alert-info text-center">@ViewBag.Message</div>
}
else if (!Model.Canciones.Any())
{
    <div class="alert alert-info text-center">Aún no tienes canciones favoritas.</div>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Título</th>
                <th>Artista</th>
                <th>Reproducir</th>
                <th>Acción</th> <!-- Botón de eliminar -->
            </tr>
        </thead>
        <tbody>
            @foreach (var cancion in Model.Canciones)
            {
                <tr>
                    <td>@cancion.Titulo</td>
                    <td>@cancion.Artista</td>
                    <td>
                        <!-- Reproductor de audio -->
                        <audio controls>
                            <source src="@cancion.UrlArchivo" type="audio/mpeg">
                            Tu navegador no soporta el elemento de audio.
                        </audio>
                    </td>
                    <td>
                        <form asp-action="QuitarMeGusta" method="post" class="d-inline">
                            <input type="hidden" name="cancionId" value="@cancion.Id" />
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Eliminar esta canción de Me Gusta?');">
                                Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
