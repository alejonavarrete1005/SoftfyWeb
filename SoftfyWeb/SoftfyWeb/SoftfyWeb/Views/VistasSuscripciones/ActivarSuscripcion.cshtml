@model List<SoftfyWeb.Modelos.Dtos.PlanDto>
@{
    ViewData["Title"] = "Seleccionar Plan";
}
<h1>@ViewData["Title"]</h1>
<form asp-action="ActivarSuscripcion" method="post">
    <div class="list-group mb-4">
        @foreach (var plan in Model)
        {
            <label class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <input type="radio" name="planId" value="@plan.Id" required />
                    <strong>@plan.Nombre</strong> - @plan.Precio.ToString("C")
                    <small>(Máx. @plan.MaxUsuarios usuarios)</small>
                </div>
                <span class="badge bg-info">@plan.Id</span>
            </label>
        }
    </div>
    <button type="submit" class="btn btn-success">Activar Plan</button>
</form>